NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_PROXY_TARGET=http://localhost:5000
API_INTERNAL_URL=http://localhost:5000/api
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

